# Discord bot token from https://discord.com/developers/applications
# (Applications -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Optional: your own Discord user ID, as an extra override so admin-only
# commands also work for you specifically. Not required if you're the
# server owner or have the Administrator permission.
BOT_OWNER_ID=

# Your real Winible Phantom Pro upgrade link, used in the welcome messages.
WINIBLE_LINK=https://winible.com

# Only needed on Render's free tier (see README.md) — starts a tiny Flask
# server so Render has a port to bind to. Leave unset/0 on Railway.
RENDER_KEEP_ALIVE=0
